  "legalHighlights": [
    {
      "article": "المادة (1)",
      "summary": "تضيف العناوين الوظيفية المنصوص عليها في المرفق رقم (1) إلى جدول الوظائف العامة الملحق بقانون الملاك."
    },
    {
      "article": "المادة (2)",
      "summary": "تحذف العناوين الوظيفية المنصوص عليها في المرفق رقم (2) من جدول الوظائف العامة، مع إبقائها داخل التطبيق للمراجعة التاريخية فقط."
    },
    {
      "article": "المادة (3)",
      "summary": "تتضمن حكمًا يتعلق باحتساب المدة لبعض حملة شهادة الدراسة الإعدادية أو ما يعادلها للوصول إلى الدرجة الثالثة وفق الجدول، مع النص على عدم صرف مستحقات مالية بأثر رجعي."
    },
    {
      "article": "المادة (4)",
      "summary": "تضيف حكمًا يجيز لمجلس الوزراء، بناءً على اقتراح وزير المالية، استحداث عناوين وظيفية جديدة تضاف إلى جداول العناوين الملحقة بالقانون."
    }
  ],
